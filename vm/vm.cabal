cabal-version: 3.8
name:          vm
version:       0.0.1
build-type:    Simple
description:   Stack-based virtual machine for the Quant language
homepage:      https://github.com/Sigmapitech/glados
bug-reports:   https://github.com/Sigmapitech/glados/issues
author:        Sigmapitech
maintainer:    Sigmapitech
copyright:     Sigmapitech
license:       BSD-2-Clause
license-file:  LICENSE

common lang
  default-language: Haskell2010

common warnings
  ghc-options: -Wall -Wextra -Wredundant-constraints -Wname-shadowing

common release
  ghc-options: -O2

library
  import:             lang
  import:             warnings
  import:             release
  hs-source-dirs:     src
  exposed-modules:
    VM
    VM.Builtins
    VM.Interpreter

  default-extensions:
    DeriveGeneric
    DerivingStrategies
    GeneralizedNewtypeDeriving
    LambdaCase
    OverloadedStrings

  build-depends:
    , aeson
    , ast
    , base
    , bytestring
    , compiler
    , containers
    , directory
    , hostname
    , mtl
    , network
    , process
    , scientific
    , text
    , time
    , unix
    , vector

test-suite vm-test
  import:         lang
  import:         warnings
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: tests
  build-depends:
    , ast
    , base
    , compiler
    , hspec
    , megaparsec
    , parser
    , text
    , vm
