# Maintainer: Fenriir42 <raid3r2205@gmail.com>
pkgname=glados
pkgver=r1.0.0
pkgrel=1
pkgdesc="The Quant programming language -- compiler CLI, LSP server, and standard library"
arch=('x86_64')
url="https://github.com/Fenriir42/glados"
license=('BSD-2-Clause')
depends=('gmp' 'zlib' 'zstd')
makedepends=('ghc' 'cabal-install')
provides=('quant-lsp')
source=("$pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$pkgname"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$pkgname"
    cabal update
}

build() {
    cd "$pkgname"
    cabal build exe:cli exe:glados-lsp --jobs="$(nproc)"
}

package() {
    cd "$pkgname"

    # binaries
    install -Dm755 "$(cabal -v0 list-bin exe:cli)"       "$pkgdir/usr/bin/glados"
    install -Dm755 "$(cabal -v0 list-bin exe:glados-lsp)" "$pkgdir/usr/bin/quant-lsp"

    # standard library
    install -d "$pkgdir/usr/share/quant/lib"
    cp -r std/. "$pkgdir/usr/share/quant/lib/"

    # license
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
