cabal-version: 3.8
name:          typechecker
version:       0.0.1
build-type:    Simple
description:   Type checker for the Quant language
homepage:      https://github.com/Sigmapitech/glados
bug-reports:   https://github.com/Sigmapitech/glados/issues
author:        Sigmapitech
maintainer:    Sigmapitech
copyright:     Sigmapitech
license:       BSD-2-Clause
license-file:  LICENSE

common lang
  default-language: Haskell2010

common warnings
  ghc-options: -Wall -Wextra -Wredundant-constraints -Wname-shadowing

common release
  ghc-options: -O2

library
  import:             lang
  import:             warnings
  import:             release
  hs-source-dirs:     src
  exposed-modules:
    TypeChecker
    TypeChecker.Builtins
    TypeChecker.Env
    TypeChecker.Error
    TypeChecker.Infer

  default-extensions:
    DeriveGeneric
    DerivingStrategies
    GeneralizedNewtypeDeriving
    LambdaCase
    OverloadedStrings

  build-depends:
    , ast
    , base
    , containers
    , mtl
    , text

test-suite typechecker-test
  import:             lang
  import:             warnings
  type:               exitcode-stdio-1.0
  main-is:            Spec.hs
  hs-source-dirs:     tests
  default-extensions: OverloadedStrings
  build-depends:
    , ast
    , base                >=4.7 && <5
    , containers
    , hspec
    , hspec-expectations
    , megaparsec
    , parser
    , text
    , typechecker
