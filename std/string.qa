# Quant Standard Library - String Module

// Returns the number of bytes in `s`.
//
// This counts raw bytes, not Unicode code points. For ASCII strings the
// result equals the number of visible characters.
fn len(s: str) -> int {
    return string.len(s);
}

// Returns a new string that is the concatenation of `a` followed by `b`.
fn concat(a: str, b: str) -> str {
    return string.concat(a, b);
}

// Returns the substring of `s` from byte index `start` (inclusive) to `end`
// (exclusive).
//
// Indices follow the same half-open convention as Python slices.
// Behaviour is undefined if indices are out of range or split a multi-byte
// character.
fn substring(s: str, start: int, end: int) -> str {
    return string.substring(s, start, end);
}

// Returns a single-character string containing the byte at `index`.
//
// Behaviour is undefined if `index` is out of range.
fn char_at(s: str, index: int) -> str {
    return string.char_at(s, index);
}

// Splits `s` on every occurrence of `delim` and returns the pieces as an
// array of strings.
//
// If `delim` is not found, returns a single-element array containing `s`.
// Adjacent delimiters produce empty-string elements.
fn split(s: str, delim: str) -> [str] {
    return string.split(s, delim);
}

// Joins the elements of `arr` into a single string, inserting `delim` between
// consecutive elements.
//
// Returns an empty string if `arr` is empty.
fn join(arr: [str], delim: str) -> str {
    return string.join(arr, delim);
}

// Returns `s` with leading and trailing ASCII whitespace removed.
fn trim(s: str) -> str {
    return string.trim(s);
}

// Returns `s` with leading ASCII whitespace removed.
fn trim_left(s: str) -> str {
    return string.trim_left(s);
}

// Returns `s` with trailing ASCII whitespace removed.
fn trim_right(s: str) -> str {
    return string.trim_right(s);
}

// Returns `s` converted to uppercase (ASCII only).
fn to_upper(s: str) -> str {
    return string.to_upper(s);
}

// Returns `s` converted to lowercase (ASCII only).
fn to_lower(s: str) -> str {
    return string.to_lower(s);
}

// Returns true if `s` contains `substr` as a substring.
fn contains(s: str, substr: str) -> bool {
    return string.contains(s, substr);
}

// Returns true if `s` starts with `prefix`.
fn starts_with(s: str, prefix: str) -> bool {
    return string.starts_with(s, prefix);
}

// Returns true if `s` ends with `suffix`.
fn ends_with(s: str, suffix: str) -> bool {
    return string.ends_with(s, suffix);
}

// Returns the byte index of the first occurrence of `substr` in `s`.
//
// Returns -1 if `substr` is not found.
fn index_of(s: str, substr: str) -> int {
    return string.index_of(s, substr);
}

// Returns the byte index of the last occurrence of `substr` in `s`.
//
// Returns -1 if `substr` is not found.
fn last_index_of(s: str, substr: str) -> int {
    return string.last_index_of(s, substr);
}

// Returns `s` with every occurrence of `old` replaced by `new`.
//
// Replacements are non-overlapping and proceed left-to-right.
fn replace(s: str, old: str, new: str) -> str {
    return string.replace(s, old, new);
}

// Returns `s` with only the first occurrence of `old` replaced by `new`.
fn replace_first(s: str, old: str, new: str) -> str {
    return string.replace_first(s, old, new);
}

// Returns `s` repeated `n` times.
//
// Returns an empty string if `n` <= 0.
fn repeat(s: str, n: int) -> str {
    return string.repeat(s, n);
}

// Returns the bytes of `s` in reverse order.
//
// Reversing a multi-byte UTF-8 string produces invalid UTF-8.
// Use only on ASCII strings.
fn reverse(s: str) -> str {
    return string.reverse(s);
}

// Returns true if `s` is empty (length 0).
fn is_empty(s: str) -> bool {
    return string.is_empty(s);
}

// Returns `s` left-padded with `pad_char` to reach at least `length` bytes.
//
// If `len(s)` >= `length`, `s` is returned unchanged.
// `pad_char` should be a single-byte (ASCII) character.
fn pad_left(s: str, length: int, pad_char: str) -> str {
    current_len: int = string.len(s);
    if (current_len >= length) {
        return s;
    };
    padding: str = string.repeat(pad_char, length - current_len);
    return string.concat(padding, s);
}

// Returns `s` right-padded with `pad_char` to reach at least `length` bytes.
//
// If `len(s)` >= `length`, `s` is returned unchanged.
// `pad_char` should be a single-byte (ASCII) character.
fn pad_right(s: str, length: int, pad_char: str) -> str {
    current_len: int = string.len(s);
    if (current_len >= length) {
        return s;
    };
    padding: str = string.repeat(pad_char, length - current_len);
    return string.concat(s, padding);
}

// Returns a non-negative integer hash of `s` using FNV-1a.
//
// The result is always in [0, 2147483646] so it is safe to use directly as
// a bucket index after a modulo operation:
//
//   bucket: int = string.hash(key) % num_buckets;
//
// The hash is deterministic within a process but not guaranteed stable across
// language versions.
fn hash(s: str) -> int {
    return string.hash(s);
}

// Returns the decimal string representation of integer `n`.
fn from_int(n: int) -> str {
    return string.from_int(n);
}

// Returns the string representation of float `f`.
fn from_float(f: float) -> str {
    return string.from_float(f);
}

// Parses `s` as a decimal integer and returns the value.
//
// Returns 0 if `s` cannot be parsed (no error is raised).
fn to_int(s: str) -> int {
    return string.to_int(s);
}

// Parses `s` as a floating-point number and returns the value.
//
// Returns 0.0 if `s` cannot be parsed (no error is raised).
fn to_float(s: str) -> float {
    return string.to_float(s);
}

// Returns a formatted string by substituting `%s`, `%d`, and `%f`
// placeholders in `fmt` with the elements of `args` in order.
//
// Example: `string.format("x=%s y=%d", ["hello", "42"])` => `"x=hello y=42"`
fn format(fmt: str, args: ...str) -> str {
    return string.format(fmt, args);
}

// Removes a single matching pair of surrounding single or double quotes from
// `v`, if present; otherwise returns `v` unchanged.
fn strip_quotes(v: str) -> str {
    n: int = string.len(v);
    if (n < 2) {
        return v;
    };
    first: str = string.char_at(v, 0);
    last: str = string.char_at(v, n - 1);
    dq: bool = False;
    if (first == "\"") {
        if (last == "\"") {
            dq = True;
        };
    };
    sq: bool = False;
    if (first == "'") {
        if (last == "'") {
            sq = True;
        };
    };
    if (dq) {
        return string.substring(v, 1, n - 1);
    };
    if (sq) {
        return string.substring(v, 1, n - 1);
    };
    return v;
}
