# Quant Standard Library - Array Module

// Returns the number of elements in `arr`.
fn len(arr: [int]) -> int {
    return array.len(arr);
}

// Appends `item` to the end of `arr`, modifying it in place.
fn push(arr: [int], item: int) -> void {
    array.push(arr, item);
}

// Removes and returns the last element of `arr`.
//
// Behaviour is undefined if `arr` is empty.
fn pop(arr: [int]) -> int {
    return array.pop(arr);
}

// Returns a new array containing the elements of `arr` in reverse order.
//
// Does not modify `arr`.
fn reverse(arr: [int]) -> [int] {
    result: [int];
    i: int = array.len(arr) - 1;
    while (i >= 0) {
        array.push(result, arr[i]);
        i--;
    };
    return result;
}

// Returns a new array containing the elements of `arr` sorted in ascending
// order.
//
// Uses bubble sort - O(n^2) time. For large arrays prefer a faster algorithm.
// Does not modify `arr`.
fn sort(arr: [int]) -> [int] {
    n: int = array.len(arr);
    result: [int];
    i: int = 0;
    while (i < n) {
        array.push(result, arr[i]);
        i++;
    };
    i = 0;
    while (i < n) {
        j: int = 0;
        while (j < n - i - 1) {
            if (result[j] > result[j + 1]) {
                temp: int = result[j];
                result[j] = result[j + 1];
                result[j + 1] = temp;
            };
            j++;
        };
        i++;
    };
    return result;
}

// Returns the index of the first element equal to `target`, or -1 if not
// found.
fn index_of(arr: [int], target: int) -> int {
    i: int = 0;
    length: int = array.len(arr);
    while (i < length) {
        if (arr[i] == target) {
            return i;
        };
        i++;
    };
    return -1;
}

// Returns true if any element of `arr` equals `target`.
fn contains(arr: [int], target: int) -> bool {
    return index_of(arr, target) != -1;
}

// Returns a new array containing elements from index `start` (inclusive) to
// `end` (exclusive).
//
// Behaviour is undefined if `start` or `end` are out of range.
fn slice(arr: [int], start: int, end: int) -> [int] {
    result: [int];
    i: int = start;
    while (i < end) {
        array.push(result, arr[i]);
        i++;
    };
    return result;
}

// Returns the sum of all elements in `arr`.
//
// Returns 0 for an empty array.
fn sum(arr: [int]) -> int {
    total: int = 0;
    i: int = 0;
    length: int = array.len(arr);
    while (i < length) {
        total = total + arr[i];
        i++;
    };
    return total;
}

// Returns the smallest element in `arr`.
//
// Returns 0 for an empty array.
fn min(arr: [int]) -> int {
    length: int = array.len(arr);
    if (length == 0) {
        return 0;
    };
    min_val: int = arr[0];
    i: int = 1;
    while (i < length) {
        if (arr[i] < min_val) {
            min_val = arr[i];
        };
        i++;
    };
    return min_val;
}

// Returns the largest element in `arr`.
//
// Returns 0 for an empty array.
fn max(arr: [int]) -> int {
    length: int = array.len(arr);
    if (length == 0) {
        return 0;
    };
    max_val: int = arr[0];
    i: int = 1;
    while (i < length) {
        if (arr[i] > max_val) {
            max_val = arr[i];
        };
        i++;
    };
    return max_val;
}

// Sets every element of `arr` to `value`, modifying it in place.
fn fill(arr: [int], value: int) -> void {
    i: int = 0;
    length: int = array.len(arr);
    while (i < length) {
        arr[i] = value;
        i++;
    };
}

// Returns a shallow copy of `arr` as a new array.
fn copy(arr: [int]) -> [int] {
    result: [int];
    i: int = 0;
    length: int = array.len(arr);
    while (i < length) {
        array.push(result, arr[i]);
        i++;
    };
    return result;
}

// Returns true if every element in `arr` is strictly positive (> 0).
//
// Returns true for an empty array (vacuous truth).
fn all_positive(arr: [int]) -> bool {
    i: int = 0;
    length: int = array.len(arr);
    while (i < length) {
        if (arr[i] <= 0) {
            return False;
        };
        i++;
    };
    return True;
}

// Returns true if at least one element in `arr` is strictly positive (> 0).
//
// Returns false for an empty array.
fn any_positive(arr: [int]) -> bool {
    i: int = 0;
    length: int = array.len(arr);
    while (i < length) {
        if (arr[i] > 0) {
            return True;
        };
        i++;
    };
    return False;
}
