# Quant Standard Library - Math Module

// Returns the absolute value of `x`.
//
// For the minimum representable int the result is implementation-defined.
fn abs(x: int) -> int {
    if (x < 0) {
        return -x;
    };
    return x;
}

// Returns the absolute value of `x` as a float.
fn fabs(x: float) -> float {
    if (x < 0.0) {
        return -x;
    };
    return x;
}

// Returns the smaller of two integers.
fn min(a: int, b: int) -> int {
    if (a < b) {
        return a;
    };
    return b;
}

// Returns the larger of two integers.
fn max(a: int, b: int) -> int {
    if (a > b) {
        return a;
    };
    return b;
}

// Returns the smaller of two floats.
fn fmin(a: float, b: float) -> float {
    if (a < b) {
        return a;
    };
    return b;
}

// Returns the larger of two floats.
fn fmax(a: float, b: float) -> float {
    if (a > b) {
        return a;
    };
    return b;
}

// Returns e raised to the power `x` (e^x).
//
// Computed via a 30-term Taylor series. Accurate to at least 10 decimal
// places for |x| <= 10; precision degrades for very large magnitudes.
fn exp(x: float) -> float {
    term: float = 1.0;
    sum: float = 1.0;
    n: int = 1;
    while (n < 30) {
        term = term * x / float(n);
        sum = sum + term;
        n++;
    };
    return sum;
}

// Returns the natural logarithm (base e) of `x`.
//
// Computed via Newton's method (25 iterations).
//
// **Panics** - exits with code 136 if `x` <= 0 (domain error).
fn log(x: float) -> float {
    if (x <= 0.0) {
        sys.exit(136);
    };
    y: float = 0.0;
    i: int = 0;
    while (i < 25) {
        ey: float = exp(y);
        y = y - (ey - x) / ey;
        i++;
    };
    return y;
}

// Returns `base` raised to the power `exponent` (base^exponent) for floats.
//
// Implemented as `exp(exponent * log(base))`.
//
// **Panics** - exits with code 136 if `base` <= 0 (log domain error).
fn pow(base: float, exponent: float) -> float {
    if (base <= 0.0) {
        sys.exit(136);
    };
    return exp(exponent * log(base));
}

// Returns the square root of `x`.
//
// Computed via Newton's method (20 iterations). Returns 0.0 exactly when
// `x` is 0.0.
//
// **Panics** - exits with code 136 if `x` < 0 (domain error).
fn sqrt(x: float) -> float {
    if (x < 0.0) {
        sys.exit(136);
    };
    if (x == 0.0) {
        return 0.0;
    };
    guess: float = x;
    i: int = 0;
    while (i < 20) {
        guess = 0.5 * (guess + x / guess);
        i++;
    };
    return guess;
}

// Returns the sine of `x` (in radians).
//
// The argument is first reduced to the range [-PI, PI], then approximated
// via a 5-term Taylor series. Accurate to ~7 decimal places.
fn sin(x: float) -> float {
    PI: float = 3.14159265358979323846;
    TAU: float = 6.28318530717958647692;
    // Reduce to [-PI, PI]
    t: float = x - float(int(x / TAU)) * TAU;
    if (t > PI) {
        t = t - TAU;
    };
    if (t < -PI) {
        t = t + TAU;
    };
    term: float = t;
    sum: float = t;
    x2: float = t * t;
    sign: float = -1.0;
    i: int = 1;
    while (i <= 5) {
        term = term * x2 / float(2*i * (2*i+1));
        sum = sum + sign * term;
        sign = -sign;
        i++;
    };
    return sum;
}

// Returns the cosine of `x` (in radians).
//
// The argument is first reduced to the range [-PI, PI], then approximated
// via a 5-term Taylor series. Accurate to ~7 decimal places.
fn cos(x: float) -> float {
    PI: float = 3.14159265358979323846;
    TAU: float = 6.28318530717958647692;
    t: float = x - float(int(x / TAU)) * TAU;
    if (t > PI) {
        t = t - TAU;
    };
    if (t < -PI) {
        t = t + TAU;
    };
    term: float = 1.0;
    sum: float = 1.0;
    x2: float = t * t;
    sign: float = -1.0;
    i: int = 1;
    while (i <= 5) {
        term = term * x2 / float((2*i-1) * (2*i));
        sum = sum + sign * term;
        sign = -sign;
        i++;
    };
    return sum;
}

// Returns the largest integer less than or equal to `x` (floor).
//
// E.g. `floor(3.9)` => 3, `floor(-1.2)` => -2.
fn floor(x: float) -> int {
    int_part: int = int(x);
    if (float(int_part) > x) {
        return int_part - 1;
    };
    return int_part;
}

// Returns the smallest integer greater than or equal to `x` (ceiling).
//
// E.g. `ceil(3.1)` => 4, `ceil(-1.8)` => -1.
fn ceil(x: float) -> int {
    int_part: int = int(x);
    if (float(int_part) < x) {
        return int_part + 1;
    };
    return int_part;
}

// Returns `x` rounded to the nearest integer.
//
// Halfway cases round away from zero: `round(0.5)` => 1, `round(-0.5)` => -1.
fn round(x: float) -> int {
    int_part: int = int(x);
    frac_part: float = x - float(int_part);
    if (frac_part >= 0.5) {
        return int_part + 1;
    };
    if (frac_part <= -0.5) {
        return int_part - 1;
    };
    return int_part;
}

// Clamps `value` to the closed interval [min_val, max_val] for integers.
//
// Returns `min_val` if `value` < `min_val`, `max_val` if `value` > `max_val`,
// otherwise returns `value` unchanged.
fn clamp(value: int, min_val: int, max_val: int) -> int {
    if (value < min_val) {
        return min_val;
    };
    if (value > max_val) {
        return max_val;
    };
    return value;
}

// Clamps `value` to the closed interval [min_val, max_val] for floats.
//
// Returns `min_val` if `value` < `min_val`, `max_val` if `value` > `max_val`,
// otherwise returns `value` unchanged.
fn fclamp(value: float, min_val: float, max_val: float) -> float {
    if (value < min_val) {
        return min_val;
    };
    if (value > max_val) {
        return max_val;
    };
    return value;
}

// Returns `n`! (n factorial) computed recursively.
//
// `factorial(0)` => 1, `factorial(1)` => 1.
//
// **Note** - overflows for n > 20 on 64-bit platforms.
// Behaviour for negative `n` is undefined.
fn factorial(n: int) -> int {
    if (n <= 1) {
        return 1;
    };
    return n * factorial(n - 1);
}

// Returns the greatest common divisor of `a` and `b`.
//
// Handles negative inputs by taking their absolute values first.
// `gcd(0, n)` = `gcd(n, 0)` = n.
fn gcd(a: int, b: int) -> int {
    a = abs(a);
    b = abs(b);
    while (b != 0) {
        temp: int = b;
        b = a % b;
        a = temp;
    };
    return a;
}

// Returns the least common multiple of `a` and `b`.
//
// Returns 0 if either argument is 0.
// Handles negative inputs via `abs` internally.
fn lcm(a: int, b: int) -> int {
    if (a == 0 || b == 0) {
        return 0;
    };
    return abs(a * b) / gcd(a, b);
}
