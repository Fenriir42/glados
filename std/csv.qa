# Quant Standard Library - CSV Module
//
// RFC 4180 comma-separated values: fields may be quoted with double quotes,
// a doubled quote inside a quoted field is a literal quote, and quoted
// fields may contain commas and newlines.  Rows are separated by newlines
// on encode (both LF and CRLF are accepted on parse).

// Parses CSV `text` into an array of rows, each an array of string fields.
fn parse(text: str) -> [[str]] {
    result: [[str]] = [];
    row: [str] = [];
    field: str = "";
    in_quotes: bool = False;
    had_content: bool = False;
    n: int = string.len(text);
    i: int = 0;
    while (i < n) {
        ch: str = string.char_at(text, i);
        if (in_quotes) {
            if (ch == "\"") {
                is_escape: bool = False;
                if (i + 1 < n) {
                    if (string.char_at(text, i + 1) == "\"") {
                        is_escape = True;
                    };
                };
                if (is_escape) {
                    field = string.concat(field, "\"");
                    i = i + 2;
                } else {
                    in_quotes = False;
                    i = i + 1;
                };
            } else {
                field = string.concat(field, ch);
                i = i + 1;
            };
        } else if (ch == "\"") {
            in_quotes = True;
            had_content = True;
            i = i + 1;
        } else if (ch == ",") {
            push(row, field);
            field = "";
            had_content = True;
            i = i + 1;
        } else if (ch == "\n") {
            push(row, field);
            push(result, row);
            row = [];
            field = "";
            had_content = False;
            i = i + 1;
        } else if (ch == "\r") {
            i = i + 1;
        } else {
            field = string.concat(field, ch);
            had_content = True;
            i = i + 1;
        };
    };
    if (had_content) {
        push(row, field);
        push(result, row);
    };
    return result;
}

// Returns the first row of `text` (the header row), or an empty array.
fn headers(text: str) -> [str] {
    all: [[str]] = parse(text);
    if (len(all) == 0) {
        empty: [str] = [];
        return empty;
    };
    return all[0];
}

// Returns the data rows of `text` -- every row after the header.
fn rows(text: str) -> [[str]] {
    all: [[str]] = parse(text);
    out: [[str]] = [];
    i: int = 1;
    while (i < len(all)) {
        push(out, all[i]);
        i = i + 1;
    };
    return out;
}

// True if `f` must be quoted to survive a round trip (contains a comma,
// quote, or newline).
fn needs_quote(f: str) -> bool {
    if (string.contains(f, ",")) {
        return True;
    };
    if (string.contains(f, "\"")) {
        return True;
    };
    if (string.contains(f, "\n")) {
        return True;
    };
    if (string.contains(f, "\r")) {
        return True;
    };
    return False;
}

// Encodes a single field, quoting and escaping it if necessary.
fn encode_field(f: str) -> str {
    if (needs_quote(f)) {
        escaped: str = string.replace(f, "\"", "\"\"");
        return string.concat("\"", string.concat(escaped, "\""));
    };
    return f;
}

// Encodes `rows` into an RFC 4180 CSV string terminated with LF newlines.
fn encode(data: [[str]]) -> str {
    out: str = "";
    i: int = 0;
    while (i < len(data)) {
        row: [str] = data[i];
        line: str = "";
        j: int = 0;
        while (j < len(row)) {
            if (j > 0) {
                line = string.concat(line, ",");
            };
            line = string.concat(line, encode_field(row[j]));
            j = j + 1;
        };
        out = string.concat(out, line);
        out = string.concat(out, "\n");
        i = i + 1;
    };
    return out;
}
