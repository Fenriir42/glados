# Quant Standard Library - System Module

// Terminates the program immediately with the given exit `code`.
//
// By convention, 0 means success and any non-zero value signals failure.
// This function never returns.
fn exit(code: int) -> void {
    sys.exit(code);
}

// Returns the number of command-line arguments, including the program name.
//
// `argc()` is always >= 1.
fn argc() -> int {
    return sys.argc();
}

// Returns the command-line arguments as an array of strings.
//
// `args()[0]` is the program name; subsequent elements are the arguments
// passed by the caller.
fn args() -> [str] {
    return sys.args();
}

// Returns the current Unix timestamp in whole seconds since the epoch
// (1970-01-01 00:00:00 UTC).
fn time() -> int {
    return sys.time();
}

// Returns the current Unix timestamp in milliseconds since the epoch.
//
// Useful for measuring elapsed time with sub-second resolution.
fn time_millis() -> int {
    return sys.time_millis();
}

// Suspends execution for `ms` milliseconds.
fn sleep(ms: int) -> void {
    sys.sleep(ms);
}

// Returns the value of the environment variable `name`.
//
// Returns an empty string `""` if the variable is not set.
fn env(name: str) -> str {
    return sys.env(name);
}

// Sets the environment variable `name` to `value`.
//
// Returns true on success, false if the OS rejects the operation.
fn set_env(name: str, value: str) -> bool {
    return sys.set_env(name, value);
}

// Returns a string identifying the host platform.
//
// Possible values: `"linux"`, `"windows"`, `"macos"`.
fn platform() -> str {
    return sys.platform();
}

// Returns the hostname of the machine as reported by the OS.
fn hostname() -> str {
    return sys.hostname();
}

// Returns the current working directory as an absolute path string.
fn getcwd() -> str {
    return sys.getcwd();
}

// Changes the current working directory to `path`.
//
// Returns true on success, false if the directory does not exist or
// the process lacks permission.
fn chdir(path: str) -> bool {
    return sys.chdir(path);
}

// Executes `command` in the system shell (equivalent to C's `system(3)`).
//
// Returns the exit code of the child process, or -1 if the shell could
// not be launched.
fn system(command: str) -> int {
    return sys.system(command);
}

// ---------------------------------------------------------------------------
// Raw file-descriptor I/O

// Writes `s` to the open file descriptor `fd` and returns the number of bytes
// actually written.  Returns -1 on error.
//
// Standard descriptors: 0 = stdin, 1 = stdout, 2 = stderr.
fn write(fd: int, s: str) -> int {
    return sys.write(fd, s);
}

// Reads up to `n` bytes from `fd` and returns them as a string.
//
// Returns an empty string on EOF or error.
fn read(fd: int, n: int) -> str {
    return sys.read(fd, n);
}

// Opens the file at `path` with the given `flags` and returns a file
// descriptor, or -1 on error.
//
// Build `flags` by combining constants with the `|` operator:
//   sys.o_rdonly()  - open for reading
//   sys.o_wronly()  - open for writing
//   sys.o_rdwr()    - open for reading and writing
//   sys.o_creat()   - create if absent (default mode 0644)
//   sys.o_trunc()   - truncate to zero on open
//   sys.o_append()  - writes always go to end of file
fn open(path: str, flags: int) -> int {
    return sys.open(path, flags);
}

// Closes the file descriptor `fd`.
//
// Returns true on success, false on error.
fn close(fd: int) -> bool {
    return sys.close(fd);
}

// Flushes any buffered output for `fd`.
fn flush(fd: int) -> void {
    sys.flush(fd);
}

// Returns true if `fd` refers to a terminal (TTY), false otherwise.
fn isatty(fd: int) -> bool {
    return sys.isatty(fd);
}

// ---------------------------------------------------------------------------
// Standard fd numbers

fn stdin_fd()  -> int { return sys.stdin_fd(); }
fn stdout_fd() -> int { return sys.stdout_fd(); }
fn stderr_fd() -> int { return sys.stderr_fd(); }

// ---------------------------------------------------------------------------
// Open flags (combine with | for sys.open)

fn o_rdonly() -> int { return sys.o_rdonly(); }
fn o_wronly() -> int { return sys.o_wronly(); }
fn o_rdwr()   -> int { return sys.o_rdwr(); }
fn o_creat()  -> int { return sys.o_creat(); }
fn o_trunc()  -> int { return sys.o_trunc(); }
fn o_append() -> int { return sys.o_append(); }
