// Microbenchmarks. Run with: glados bench benchmarks/fib_bench.qa
from bench import bench_fn

fn fib(n: int) -> int {
    if (n < 2) {
        return n;
    };
    return fib(n - 1) + fib(n - 2);
}

fn sum_to(n: int) -> int {
    total: int = 0;
    i: int = 0;
    while (i < n) {
        total = total + i;
        i = i + 1;
    };
    return total;
}

fn bench_fib20() -> void {
    bench_fn("fib(20)", 50, fn() -> void { fib(20); });
}

fn bench_sum() -> void {
    bench_fn("sum_to(1000)", 200, fn() -> void { sum_to(1000); });
}
