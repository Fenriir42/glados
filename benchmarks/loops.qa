// Loop / arithmetic-heavy benchmark: nested integer accumulation.
fn main() -> void {
    total: int = 0;
    i: int = 0;
    while (i < 1200) {
        j: int = 0;
        while (j < 1200) {
            total = total + (i * j) % 7;
            j = j + 1;
        };
        i = i + 1;
    };
    println(total);
}
