// Array + branch-heavy benchmark: count primes below N by trial division.
fn is_prime(n: int) -> bool {
    if (n < 2) {
        return False;
    };
    d: int = 2;
    while (d * d <= n) {
        if (n % d == 0) {
            return False;
        };
        d = d + 1;
    };
    return True;
}

fn main() -> void {
    count: int = 0;
    n: int = 2;
    while (n < 60000) {
        if (is_prime(n)) {
            count = count + 1;
        };
        n = n + 1;
    };
    println(count);
}
