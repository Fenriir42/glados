cabal-version: 3.8
name:          formatter
version:       0.1.0
build-type:    Simple
description:   Quant language code formatter (rustfmt-style)
homepage:      https://github.com/Sigmapitech/glados
bug-reports:   https://github.com/Sigmapitech/glados/issues
author:        Sigmapitech
maintainer:    Sigmapitech
copyright:     Sigmapitech
license:       BSD-2-Clause
license-file:  LICENSE

common lang
  default-language: Haskell2010

common warnings
  ghc-options: -Wall -Wextra -Wredundant-constraints -Wname-shadowing

library
  import:             lang
  import:             warnings
  hs-source-dirs:     src
  exposed-modules:
    Config
    Formatter

  default-extensions:
    LambdaCase
    OverloadedStrings

  build-depends:
    , ast
    , base        >=4.11 && <5
    , containers
    , text

executable quant-fmt
  import:             lang
  import:             warnings
  main-is:            Main.hs
  hs-source-dirs:     app
  default-extensions:
    LambdaCase
    OverloadedStrings

  ghc-options:        -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    , ast
    , base                  >=4.11 && <5
    , directory
    , filepath
    , formatter
    , megaparsec
    , optparse-applicative
    , parser
    , text
