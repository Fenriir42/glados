struct Point {
    x: int,
    y: int
}

struct Rectangle {
    width: int,
    height: int
}

struct Color {
    r: int,
    g: int,
    b: int
}

# Return the area of a rectangle.
fn area(rect: Rectangle) -> int {
    return rect.width * rect.height;
}

# Return the perimeter of a rectangle.
fn perimeter(rect: Rectangle) -> int {
    return 2 * (rect.width + rect.height);
}

# Translate a point by (dx, dy) and return the new point.
fn translate(p: Point, dx: int, dy: int) -> Point {
    p.x = p.x + dx;
    p.y = p.y + dy;
    return p;
}

# Squared distance from the origin.
fn dist_sq(p: Point) -> int {
    return p.x * p.x + p.y * p.y;
}

# Mix two colours by averaging each channel.
fn mix(a: Color, b: Color) -> Color {
    a.r = (a.r + b.r) / 2;
    a.g = (a.g + b.g) / 2;
    a.b = (a.b + b.b) / 2;
    return a;
}

fn main() -> void {
    # basic construction and field access
    p: Point = Point { x: 3, y: 4 };
    println(p.x);
    println(p.y);

    # field assignment
    p.x = 10;
    println(p.x);

    # struct passed to a function, returned and re-used
    p2: Point = translate(p, -1, 6);
    println(p2.x);
    println(p2.y);

    # computed field via function
    println(dist_sq(Point { x: 3, y: 4 }));

    # rectangle
    rect: Rectangle = Rectangle { width: 8, height: 5 };
    println(area(rect));
    println(perimeter(rect));

    # field update on a rectangle
    rect.width = 10;
    println(area(rect));

    # colour mixing
    red: Color = Color { r: 255, g: 0, b: 0 };
    blue: Color = Color { r: 0, g: 0, b: 255 };
    purple: Color = mix(red, blue);
    println(purple.r);
    println(purple.g);
    println(purple.b);

    # struct fields used in expressions
    a: Point = Point { x: 5, y: 10 };
    b: Point = Point { x: 3, y: 7 };
    sum_x: int = a.x + b.x;
    sum_y: int = a.y + b.y;
    println(sum_x);
    println(sum_y);
}
