// Showcase / test for the std/crypto module (SHA-256 known vectors).
from crypto import sha256_hex

fn main() -> void {
    // NIST test vectors.
    println("empty  = %s", sha256_hex(""));
    println("abc    = %s", sha256_hex("abc"));
    println("quick  = %s", sha256_hex("The quick brown fox jumps over the lazy dog"));
    // Longer than one block (> 55 bytes) to exercise multi-block padding.
    println("long   = %s", sha256_hex("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"));
}
