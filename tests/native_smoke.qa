// Native backend smoke test (stage 2 subset).
// Exercises: functions, recursion, loops, conditionals, arithmetic
// (int and float, floor div/mod), comparisons, logic, casts, arrays,
// strings, and print/println -- everything the C translator covers.
// Run under both engines and diff:
//   glados compiler tests/native_smoke.qa
//   glados compiler tests/native_smoke.qa --native /tmp/smoke && /tmp/smoke

fn fib(n: int) -> int {
    if (n < 2) {
        return n;
    };
    return fib(n - 1) + fib(n - 2);
}

fn sum_to(n: int) -> int {
    total: int = 0;
    for (i: int = 1; i <= n; i++) {
        total = total + i;
    };
    return total;
}

fn main() -> void {
    println("hello from quant");

    // recursion
    println(fib(20));

    // loops and accumulation
    println(sum_to(100));

    // integer arithmetic: floor division and modulo like the VM
    println(7 / 2);
    println(-7 / 2);
    println(7 % 3);
    println(-7 % 3);

    // float arithmetic
    x: float = 3.5;
    println(x * 2.0);
    println(float(1) + 0.5);
    println(10.0 / float(4));

    // comparisons and logic
    println(3 < 4);
    println(4 <= 3);
    println(1.5 > 1.0);
    b: bool = True;
    println(b && False);
    println(b || False);

    // bitwise
    println(6 & 3);
    println(6 | 3);
    println(6 ^ 3);
    println(1 << 5);
    println(64 >> 2);

    // casts
    println(int(3.99));
    println(float(21));
    println(string.to_str(42));
    println(string.concat("con", "cat"));

    // arrays
    arr: [int] = [10, 20, 30];
    push(arr, 40);
    println(len(arr));
    println(arr[0] + arr[3]);
    arr[1] = 21;
    println(arr[1]);

    // while with break/continue
    i: int = 0;
    hits: int = 0;
    while (True) {
        i++;
        if (i > 10) {
            break;
        };
        if (i % 2 == 0) {
            continue;
        };
        hits = hits + 1;
    };
    println(hits);
}
