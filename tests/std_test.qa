// Showcase / test for the std/test property-testing module.
from test import forall_int

// A property that always holds over [0, 999].
fn is_nonneg(x: int) -> bool {
    return x >= 0;
}

// A property that fails for large values, to demonstrate shrinking.
fn under_500(x: int) -> bool {
    return x < 500;
}

// A property with a clean shrink target: fails for even numbers.
fn is_odd(x: int) -> bool {
    return x % 2 == 1;
}

fn main() -> void {
    println("-- always-true property --");
    forall_int(12345, 30, 0, 999, is_nonneg);

    println("-- failing property (shrinks toward 500) --");
    forall_int(12345, 30, 0, 999, under_500);

    println("-- parity property --");
    forall_int(999, 20, 0, 100, is_odd);
}
