# LSP showcase for the Quant language.
# Open this file with the Quant LSP extension active to explore:
#
#   Hover              - hover any name to see its type and docs
#   Completion         - type inside a fn body, suggestions appear
#   Go to definition   - Ctrl+click / F12 on any fn or variable name
#   Signature help     - open ( after a fn name to see its parameter list
#   Document symbols   - OUTLINE panel lists every fn declared below
#   Document highlight - click a name, all occurrences glow blue
#   Find references    - right-click -> Find All References
#   Rename             - F2 on any user-defined fn or local variable
#   Folding            - chevrons in gutter collapse fn bodies and blocks
#   Inlay hints        - parameter names appear greyed-out before each arg
#   Semantic tokens    - fn calls and variables get theme-aware colours

from math import sqrt, pow, floor, abs, gcd, factorial, clamp
from string import len, concat, to_upper, reverse, repeat, from_int, substring
from array import sort, sum, min, max, slice, contains, index_of

# ---------------------------------------------------------------------------
# User-defined helpers (try go-to-def, highlight, references, and rename here)

// Compute the hypotenuse of a right triangle using the Pythagorean theorem.
fn hypotenuse(a: float, b: float) -> float {
    a_sq: float = pow(a, 2.0);
    b_sq: float = pow(b, 2.0);
    return sqrt(a_sq + b_sq);
}

// Return the absolute difference between two integers.
fn abs_diff(x: int, y: int) -> int {
    diff: int = x - y;
    return abs(diff);
}

// Build a labelled output line: "label: value".
fn labelled(label: str, value: str) -> str {
    return `{label}: {value}`;
}

// Compute the nth triangular number: 1+2+...+n.
fn triangular(n: int) -> int {
    return n * (n + 1) / 2;
}

# ---------------------------------------------------------------------------
# Demo sections (each fn appears in the OUTLINE panel via document symbols)

// Demonstrate math functions and user-defined helpers.
// Hover calls to see inlay hints for parameter names (e.g. hypotenuse(a:, b:)).
fn demo_math() -> void {
    h: float = hypotenuse(3.0, 4.0);
    println(labelled("hypotenuse(3,4)", from_int(floor(h))));   # hypotenuse(3,4): 5

    d: int = abs_diff(17, 5);
    println(labelled("abs_diff(17,5)", from_int(d)));           # abs_diff(17,5): 12

    g: int = gcd(48, 18);
    println(labelled("gcd(48,18)", from_int(g)));               # gcd(48,18): 6

    f: int = factorial(6);
    println(labelled("factorial(6)", from_int(f)));             # factorial(6): 720

    t: int = triangular(10);
    println(labelled("triangular(10)", from_int(t)));           # triangular(10): 55
}

// Demonstrate string functions: concat, repeat, reverse, substring.
fn demo_string() -> void {
    greeting: str = concat("Hello, ", "Quant");
    println(greeting);                                          # Hello, Quant

    loud: str = to_upper(greeting);
    println(loud);                                              # HELLO, QUANT

    rev: str = reverse("abcde");
    println(rev);                                               # edcba

    sub: str = substring("language", 0, 4);
    println(sub);                                               # lang

    repeated: str = repeat("ha", 3);
    println(repeated);                                          # hahaha

    n: int = len("hello world");
    println(labelled("len", from_int(n)));                      # len: 11
}

// Demonstrate array functions and a while loop (both blocks are foldable).
fn demo_array() -> void {
    nums: [int] = [5, 2, 8, 1, 9, 3];

    println(labelled("sum", from_int(sum(nums))));              # sum: 28
    println(labelled("min", from_int(min(nums))));              # min: 1
    println(labelled("max", from_int(max(nums))));              # max: 9

    sorted: [int] = sort(nums);
    first_three: [int] = slice(sorted, 0, 3);

    i: int = 0;
    while (i < 3) {
        println(from_int(first_three[i]));                      # 1, 2, 3
        i++;
    };

    found: bool = contains(nums, 8);
    if (found) {
        println(labelled("index of 8", from_int(index_of(nums, 8))));   # index of 8: 2
    };
}

// Demonstrate a for loop and triangular called multiple times.
// Try Find References on triangular to see all call sites highlighted.
fn demo_loops() -> void {
    for (i: int = 1; i <= 5; i++) {
        t: int = triangular(i);
        line: str = concat(from_int(i), concat(" -> ", from_int(t)));
        println(line);                                          # 1->1, 2->3, 3->6, ...
    };

    total: int = 0;
    j: int = 1;
    while (j <= 4) {
        total = total + abs_diff(j * j, j);
        j++;
    };
    println(labelled("total", from_int(total)));                # total: 20
}

// Apply a function to each of the first n elements of arr and return a new array.
fn map_ints(arr: [int], f: (int) -> int, n: int) -> [int] {
    result: [int] = [];
    i: int = 0;
    while (i < n) {
        push(result, f(arr[i]));
        i++;
    };
    return result;
}

// Generic identity: return the value unchanged, works for any type T.
fn identity[T](x: T) -> T {
    return x;
}

// Generic map: apply f to each of the first n elements of arr, collect results.
fn map_arr[T, U](arr: [T], f: (T) -> U, n: int) -> [U] {
    result: [U] = [];
    i: int = 0;
    while (i < n) {
        push(result, f(arr[i]));
        i++;
    };
    return result;
}

// Demonstrate first-class functions: references, lambdas, higher-order fns.
fn demo_first_class() -> void {
    // Store a named function in a variable
    square: (int) -> int = abs;
    println(labelled("abs(-9)", from_int(square(-9))));        # abs(-9): 9

    // Lambda stored in a variable
    triple: (int) -> int = fn(x: int) -> int { return x * 3; };
    println(labelled("triple(7)", from_int(triple(7))));       # triple(7): 21

    // Higher-order function: map with a lambda
    nums: [int] = [1, 2, 3, 4];
    doubled: [int] = map_ints(nums, fn(x: int) -> int { return x * 2; }, 4);
    i: int = 0;
    while (i < 4) {
        println(from_int(doubled[i]));                          # 2, 4, 6, 8
        i++;
    };
}

// Demonstrate generics: identity with multiple types, generic map over array.
fn demo_generics() -> void {
    // identity[T] called at different concrete types
    n: int = identity(99);
    s: str = identity("quant");
    println(labelled("identity(int)", from_int(n)));    # identity(int): 99
    println(labelled("identity(str)", s));              # identity(str): quant

    // map_arr[int, int]: double each element
    nums: [int] = [1, 2, 3, 4, 5];
    doubled: [int] = map_arr(nums, fn(x: int) -> int { return x * 2; }, 5);
    i: int = 0;
    while (i < 5) {
        println(from_int(doubled[i]));                  # 2, 4, 6, 8, 10
        i++;
    };

    // map_arr[int, str]: convert each element to a labelled string
    labels: [str] = map_arr(nums, fn(x: int) -> str { return concat("n=", from_int(x)); }, 3);
    j: int = 0;
    while (j < 3) {
        println(labels[j]);                             # n=1, n=2, n=3
        j++;
    };
}

error ParseError { line: int, msg: str };

fn parse_number(src: str) -> orerror(int, ParseError) {
    if (len(src) == 0) {
        return error ParseError { line: 1, msg: "empty input" };
    };
    return 99;
}

// Demonstrate match: value patterns, ranges, ok/err branches, field access.
fn demo_match() -> void {
    // Integer literal and range patterns
    for (i: int = 0; i <= 12; i++) {
        match i {
            0     => println(labelled("zero", from_int(i)));
            1..9  => println(labelled("digit", from_int(i)));
            10..12 => println(labelled("teens", from_int(i)));
            _     => println(labelled("large", from_int(i)));
        };
    };

    // ok / err branches on an orerror result
    good: orerror(int, ParseError) = parse_number("42");
    match good {
        ok(n)            => println(labelled("parsed", from_int(n)));
        err(ParseError e) => println(labelled("error", e.msg));
    };

    bad: orerror(int, ParseError) = parse_number("");
    match bad {
        ok(n)            => println(labelled("parsed", from_int(n)));
        err(ParseError e) => println(`line {e.line}: {e.msg}`);
    };
}

fn main() -> void {
    demo_math();
    demo_string();
    demo_array();
    demo_loops();
    demo_first_class();
    demo_generics();
    demo_match();
    println("done");
}
