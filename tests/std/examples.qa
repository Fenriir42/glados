# Integration examples for the Quant standard library.
# Run with: glados compiler tests/std/examples.qa

from math import sqrt, abs, factorial, gcd, floor
from string import len, concat, to_upper, reverse, repeat, from_int
from array import sum, min, max, sort

fn test_math() -> void {
    println("=== Math ===");
    println(sqrt(16.0));        # 4.0
    println(abs(-42));          # 42
    println(floor(sqrt(2.0) * 1000.0));  # 1414 (√2 ≈ 1.4142…)
    println(factorial(6));      # 720
    println(gcd(48, 18));       # 6
    println(floor(3.9));        # 3
}

fn test_string() -> void {
    println("=== String ===");
    println(len("hello"));                   # 5
    println(concat("foo", "bar"));           # foobar
    println(to_upper("quant"));              # QUANT
    println(reverse("abcde"));              # edcba
    println(repeat("ha", 3));               # hahaha
    println(from_int(42));                   # 42
}

fn test_array() -> void {
    println("=== Array ===");
    nums: [int] = [5, 2, 8, 1, 9, 3];
    println(sum(nums));         # 28
    println(min(nums));         # 1
    println(max(nums));         # 9
    sorted: [int] = sort(nums);
    println(sorted[0]);         # 1
    println(sorted[5]);         # 9
}

fn main() -> void {
    test_math();
    test_string();
    test_array();
    println("done");
}
