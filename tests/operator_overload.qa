struct Vec2 {
    x: float,
    y: float,
}

impl Vec2 {
    fn to_str(self) -> str {
        return `({self.x}, {self.y})`;
    }
}

impl Add for Vec2 {
    fn add(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x + other.x, y: self.y + other.y };
    }
}

impl Sub for Vec2 {
    fn sub(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x - other.x, y: self.y - other.y };
    }
}

impl Mul for Vec2 {
    fn mul(self, other: Vec2) -> Vec2 {
        return Vec2 { x: self.x * other.x, y: self.y * other.y };
    }
}

impl Neg for Vec2 {
    fn neg(self) -> Vec2 {
        return Vec2 { x: -self.x, y: -self.y };
    }
}

impl Eq for Vec2 {
    fn eq(self, other: Vec2) -> bool {
        return self.x == other.x && self.y == other.y;
    }
}

fn main() -> void {
    a: Vec2 = Vec2 { x: 1.0, y: 2.0 };
    b: Vec2 = Vec2 { x: 3.0, y: 4.0 };

    sum: Vec2 = a + b;
    println(sum.to_str());

    diff: Vec2 = b - a;
    println(diff.to_str());

    prod: Vec2 = a * b;
    println(prod.to_str());

    neg_a: Vec2 = -a;
    println(neg_a.to_str());

    c: Vec2 = Vec2 { x: 1.0, y: 2.0 };
    if (a == c) {
        println("equal");
    } else {
        println("not equal");
    };
    if (a == b) {
        println("equal");
    } else {
        println("not equal");
    };
}
