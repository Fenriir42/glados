// Showcase / test for the std/yaml module: flat maps and nested parsing.
from yaml import parse_map, encode_map, parse

fn dump(d: dict(str, str)) -> void {
    ks: [str] = dict.keys(d);
    i: int = 0;
    while (i < len(ks)) {
        println("  %s = %s", ks[i], d[ks[i]]);
        i = i + 1;
    };
}

fn main() -> void {
    // --- flat map (parse_map) ---
    flat: str = "# a config file\nname: quant\nversion: \"1.0.0\"\nport: 8080\n\ngreeting: 'hello: world'\n";
    d: dict(str, str) = parse_map(flat);
    println("flat name = %s", d["name"]);
    println("flat greeting = %s", d["greeting"]);
    println("-- re-encode --");
    print(encode_map(d));

    // --- nested parse (dotted paths + sequences) ---
    nested: str = "server:\n  host: localhost\n  port: 8080\n  tags:\n    - web\n    - api\ndatabase:\n  url: pg://db\n  opts:\n    ssl: true\n";
    println("-- nested --");
    dump(parse(nested));
}
