cabal-version: 3.8
name:          lsp-server
version:       0.0.1
build-type:    Simple
description:   Language Server Protocol server for the Quant language
homepage:      https://github.com/Sigmapitech/glados
bug-reports:   https://github.com/Sigmapitech/glados/issues
author:        Sigmapitech
maintainer:    Sigmapitech
copyright:     Sigmapitech
license:       BSD-2-Clause
license-file:  LICENSE

common lang
  default-language: Haskell2010

common warnings
  ghc-options: -Wall -Wextra -Wredundant-constraints -Wname-shadowing

executable glados-lsp
  import:             lang
  import:             warnings
  main-is:            Main.hs
  hs-source-dirs:     src
  other-modules:
    LSPServer.Analyze
    LSPServer.CallHierarchy
    LSPServer.CodeAction
    LSPServer.CodeLens
    LSPServer.Completion
    LSPServer.Definition
    LSPServer.DocumentSymbol
    LSPServer.Folding
    LSPServer.Highlight
    LSPServer.Hover
    LSPServer.InlayHints
    LSPServer.References
    LSPServer.Rename
    LSPServer.SemanticTokens
    LSPServer.SignatureHelp
    LSPServer.Span
    LSPServer.TypeDefinition

  default-extensions:
    DuplicateRecordFields
    LambdaCase
    OverloadedStrings

  ghc-options:        -threaded -rtsopts -with-rtsopts=-N -O2
  build-depends:
    , aeson
    , ast
    , base         >=4.11 && <5
    , compiler
    , containers
    , directory
    , filepath
    , lsp          >=2.4
    , lsp-types    >=2.4
    , megaparsec
    , parser
    , stm
    , text
    , typechecker
