cabal-version: 3.8
name:          dap-server
version:       0.1.0
build-type:    Simple
description:   Debug Adapter Protocol server for the Quant language
homepage:      https://github.com/Sigmapitech/glados
bug-reports:   https://github.com/Sigmapitech/glados/issues
author:        Sigmapitech
maintainer:    Sigmapitech
copyright:     Sigmapitech
license:       BSD-2-Clause
license-file:  LICENSE

common lang
  default-language: Haskell2010

common warnings
  ghc-options: -Wall -Wextra -Wredundant-constraints -Wname-shadowing

executable quant-dap
  import:             lang
  import:             warnings
  main-is:            Main.hs
  other-modules:
    DAP.DebugInfo
    DAP.Protocol
    DAP.Server

  hs-source-dirs:     src
  ghc-options:        -threaded -rtsopts -with-rtsopts=-N -O2
  default-extensions:
    LambdaCase
    OverloadedStrings

  build-depends:
    , aeson        >=2.0
    , ast
    , base         >=4.11 && <5
    , bytestring
    , compiler
    , containers
    , directory
    , filepath
    , megaparsec
    , mtl
    , parser
    , stm
    , text
    , typechecker
    , unix
    , vm
