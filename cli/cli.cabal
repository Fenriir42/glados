cabal-version: 3.8
name:          cli
version:       1.0.0
build-type:    Simple
description:   Generic Language and data operand syntax
homepage:      https://github.com/Sigmapitech/glados
bug-reports:   https://github.com/Sigmapitech/glados/issues
author:        Sigmapitech
maintainer:    Sigmapitech
copyright:     Sigmapitech
license:       BSD-2-Clause
license-file:  LICENSE

common lang
  default-language: Haskell2010

common warnings
  ghc-options: -Wall -Wextra -Wredundant-constraints -Wname-shadowing

common release
  ghc-options: -O2

executable cli
  import:         lang
  import:         warnings
  import:         release
  ghc-options:    -threaded -with-rtsopts=-N
  main-is:        Main.hs
  other-modules:
    Compile
    Display
    Fuzz
    Manifest
    NativeDiff
    Panik
    PM

  hs-source-dirs: src
  build-depends:
    , ast
    , base
    , bytestring
    , compiler
    , containers
    , directory
    , filepath
    , megaparsec
    , optparse-applicative
    , parser
    , process
    , text
    , time
    , typechecker
    , vm

test-suite cli-test
  import:         lang
  import:         warnings
  type:           exitcode-stdio-1.0
  main-is:        Spec.hs
  hs-source-dirs: tests
  build-depends:
    , ast
    , base
    , compiler
    , hspec
    , megaparsec
    , parser
    , temporary
    , text
    , typechecker
    , vm
