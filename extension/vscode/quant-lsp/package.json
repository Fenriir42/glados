{
  "name": "quant-lsp",
  "displayName": "Quant Language Server",
  "description": "LSP support for Quant: diagnostics, hover types, and improved syntax highlighting",
  "version": "0.2.1",
  "publisher": "quant-team",
  "author": {
    "name": "Quant team"
  },
  "license": "BSD-2-Clause",
  "icon": "assets/quant-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sigmapitech/glados"
  },
  "bugs": {
    "url": "https://github.com/Sigmapitech/glados/issues"
  },
  "keywords": [
    "quant",
    "lsp",
    "language-server",
    "diagnostics"
  ],
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Debuggers"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "quant",
        "aliases": [
          "Quant",
          "quant"
        ],
        "extensions": [
          ".qa"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./assets/quant-icon.png",
          "dark": "./assets/quant-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "quant",
        "scopeName": "source.quant",
        "path": "./syntaxes/quant.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "quant",
        "path": "./snippets/quant.json"
      }
    ],
    "commands": [
      {
        "command": "quant-lsp.showReferences",
        "title": "Show References",
        "category": "Quant"
      },
      {
        "command": "quant-lsp.runFile",
        "title": "Run File",
        "category": "Quant"
      }
    ],
    "configuration": {
      "title": "Quant Language Server",
      "properties": {
        "quant-lsp.enable": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Enable the Quant language server (diagnostics, hover types)."
        },
        "quant-lsp.serverPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `quant-lsp` binary. Leave empty to search `$PATH`."
        },
        "quant-lsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "No tracing",
            "Log request/response messages",
            "Log all LSP traffic including notifications"
          ],
          "default": "off",
          "markdownDescription": "Trace LSP communication between VS Code and the Quant language server."
        },
        "quant-lsp.debugAdapterPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `quant-dap` debug adapter binary. Leave empty to search `$PATH`."
        },
        "quant-lsp.gladosPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Absolute path to the `glados` binary. Leave empty to search `$PATH`."
        }
      }
    },
    "debuggers": [
      {
        "type": "quant",
        "label": "Quant Debug",
        "languages": [
          "quant"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the Quant source file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": false,
                "description": "Break immediately when the program starts."
              },
              "stdlib": {
                "type": "string",
                "default": "",
                "description": "Path to the Quant standard library directory (overrides QUANT_STDLIB)."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "quant",
            "request": "launch",
            "name": "Debug Quant File",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "Quant: Debug Current File",
            "description": "Debug the currently open Quant file.",
            "body": {
              "type": "quant",
              "request": "launch",
              "name": "Debug Quant File",
              "program": "^\"${1:${file}}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "watch": "npm run compile -- --watch",
    "vscode:prepublish": "npm run compile -- --minify",
    "lint": "tsc --noEmit",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.82.0",
    "@vscode/vsce": "^2.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
